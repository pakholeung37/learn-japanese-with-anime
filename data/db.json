    "%5BCASO%26I.G%5D%5BK-ON!%5D-ep02-1920x1080": {
      "0:00:06.34-0:00:07.07-goir7p": {
        "text": "一緒に帰ろ",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:07.65-0:00:11.33-2nfq7i": {
        "text": "ごめん　今日　どうしても　部活に　行かなきゃいけないんだ",
        "isStarred": false,
        "time": 1780386866745
      },
      "0:00:11.60-0:00:14.26-uaho0i": {
        "text": "そうなんだ　それじゃあ　仕方ないね",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:14.74-0:00:17.06-9q8k64": {
        "text": "ゆいにも　打ち込めるものができたのね",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:20.75-0:00:21.51-bm935z": {
        "text": "どうしたの",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:30.84-0:00:32.35-bhguft": {
        "text": "よう",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:36.41-0:00:41.00-29a759": {
        "text": "中学生に　なっても　ずっと ぼと　生きてきた　けど",
        "isStarred": true,
        "time": 1780387400577
      },
      "0:00:25.07-0:00:26.37-qfpmzf": {
        "text": "ギターやるんじゃないの",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:45.65-0:00:48.05-m6cx8m": {
        "text": "高校生　になった　私は初めて",
        "isStarred": true,
        "time": 1780387166695
      },
      "0:00:49.66-0:00:51.46-hp07v": {
        "text": "部活を　始めました",
        "isStarred": true,
        "time": 1780387148076
      },
      "0:00:34.27-0:00:35.74-mg6clu": {
        "text": "小学生の時も",
        "isStarred": false,
        "time": 1780386923637
      },
      "0:02:23.74-0:02:24.92-9r20uk": {
        "text": "こんにちは",
        "isStarred": false,
        "time": 1780391765344
      },
      "0:02:25.64-0:02:28.25-jz0j45": {
        "text": "この三人が　軽音部の　仲間です",
        "isStarred": false,
        "time": 1780391821971
      },
      "0:02:28.41-0:02:29.19-q18d4z": {
        "text": "こんにちは",
        "isStarred": false,
        "time": 1780391915740
      },
      "0:02:29.33-0:02:31.61-foq7z3": {
        "text": "ベース担当の 秋山澪　ちゃん",
        "isStarred": false,
        "time": 1780392180661
      },
      "0:02:34.95-0:02:38.84-bdlitf": {
        "text": "背が高くてかっこいい　大人の女性 って感じです",
        "isStarred": false,
        "time": 1780394241627
      },
      "0:02:39.39-0:02:40.78-7zao9l": {
        "text": "ねえねえ　なんで　澪ちゃんは",
        "isStarred": false,
        "time": 1780393679316
      },
      "0:02:40.91-0:02:43.50-q5u0wi": {
        "text": "ギターじゃなくて　ベース　を　やろ　しようと思った",
        "isStarred": true,
        "time": 1780393968350
      },
      "0:02:45.58-0:02:46.76-8j5a70": {
        "text": "だって　ギターは",
        "isStarred": false,
        "time": 1780394412702
      },
      "0:02:47.52-0:02:48.71-cs7wzp": {
        "text": "は　恥ずかしい",
        "isStarred": false,
        "time": 1780394424054
      },
      "0:02:49.34-0:02:50.17-62ii86": {
        "text": "恥ずかしい",
        "isStarred": false,
        "time": 1780394451842
      },
      "0:02:50.36-0:02:52.81-gssj4f": {
        "text": "ギターって　バンドの中心　って感じで",
        "isStarred": true,
        "time": 1780412147295
      },
      "0:02:53.10-0:02:55.63-tioc4g": {
        "text": "先頭に　立って　演奏しなきゃいけないし",
        "isStarred": true,
        "time": 1780412140946
      },
      "0:02:56.00-0:02:58.35-95phf6": {
        "text": "観客の目も　自然と　あつまぅだろ",
        "isStarred": true,
        "time": 1780412149015
      },
      "0:02:59.29-0:03:02.54-j2l5d6": {
        "text": "自分が　その立場になるって　考えた　だけで",
        "isStarred": false,
        "time": 1780412503453
      },
      "0:03:04.33-0:03:05.26-bzfe66": {
        "text": "澪ちゃん",
        "isStarred": false,
        "time": 1780412514298
      },
      "0:03:05.39-0:03:07.69-ie52rf": {
        "text": "澪ちゃんは　少し　繊細です",
        "isStarred": false,
        "time": 1780412565303
      },
      "0:03:07.80-0:03:08.59-5kyfuy": {
        "text": "大丈夫",
        "isStarred": false,
        "time": 1780412634632
      },
      "0:03:09.17-0:03:11.89-ku1gxy": {
        "text": "キーボード担当　ムギちゃん",
        "isStarred": false,
        "time": 1780412682136
      },
      "0:03:17.00-0:03:18.08-7ca1ce": {
        "text": "通称　ムギちゃん",
        "isStarred": false,
        "time": 1780412721060
      },
      "0:03:18.51-0:03:21.20-kuxxgl": {
        "text": "おっとり　ぽわぽわ　可愛い人です",
        "isStarred": false,
        "time": 1780412826136
      },
      "0:03:21.87-0:03:23.93-xmtaws": {
        "text": "ムギちゃんは　キーボード　うまいよね",
        "isStarred": false,
        "time": 1780412847465
      },
      "0:03:24.21-0:03:25.81-dum3z7": {
        "text": "キーボード歴長いの",
        "isStarred": false,
        "time": 1780413006672
      },
      "0:03:26.13-0:03:28.89-tnhtvx": {
        "text": "私　四歳のころから　ピアノを　習ってたの",
        "isStarred": false,
        "time": 1780413227353
      },
      "0:03:29.24-0:03:31.96-doragc": {
        "text": "コンクールで賞を　もらった　こともあるのよ",
        "isStarred": false,
        "time": 1780413570804
      },
      "0:03:32.09-0:03:34.36-ichy82": {
        "text": "へえ　すごいね",
        "isStarred": false,
        "time": 1780413671711
      },
      "0:03:34.69-0:03:36.72-uoxg3i": {
        "text": "何で軽音部に　いるんだろう",
        "isStarred": false,
        "time": 1780413724523
      },
      "0:03:37.16-0:03:38.69-ciufyo": {
        "text": "さあ　いただきましょう",
        "isStarred": false,
        "time": 1780413927588
      },
      "0:03:40.01-0:03:42.71-xie5aw": {
        "text": "そういえば　ずっと　疑問に　思ってただけど",
        "isStarred": true,
        "time": 1780466329825
      },
      "0:03:43.01-0:03:45.49-3rqqkc": {
        "text": "この部室って　やけに　ものが　揃ってる　よね",
        "isStarred": true,
        "time": 1780466801373
      },
      "0:03:45.76-0:03:48.57-a2wia7": {
        "text": "最近の　高校って　こんな感じ　なのかな",
        "isStarred": false,
        "time": 1780466781282
      }
    }
  },
  "progress": {}
}