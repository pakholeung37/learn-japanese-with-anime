    "%5BCASO%26I.G%5D%5BK-ON!%5D-ep02-1920x1080": {
      "0:00:06.34-0:00:07.07-goir7p": {
        "text": "一緒に帰ろ",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:07.65-0:00:11.33-2nfq7i": {
        "text": "ごめん　今日　どうしても　部活に　行かなきゃいけないんだ",
        "isStarred": false,
        "time": 1780386866745
      },
      "0:00:11.60-0:00:14.26-uaho0i": {
        "text": "そうなんだ　それじゃあ　仕方ないね",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:14.74-0:00:17.06-9q8k64": {
        "text": "ゆいにも　打ち込めるものができたのね",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:20.75-0:00:21.51-bm935z": {
        "text": "どうしたの",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:30.84-0:00:32.35-bhguft": {
        "text": "幼稚園の時も",
        "isStarred": false,
        "time": 1780542845944
      },
      "0:00:36.41-0:00:41.00-29a759": {
        "text": "中学生に　なっても　ずっと ぼと　生きてきた　けど",
        "isStarred": true,
        "time": 1780387400577
      },
      "0:00:25.07-0:00:26.37-qfpmzf": {
        "text": "ギターやるんじゃないの",
        "isStarred": false,
        "time": 1780386860303
      },
      "0:00:45.65-0:00:48.05-m6cx8m": {
        "text": "高校生　になった　私は初めて",
        "isStarred": true,
        "time": 1780387166695
      },
      "0:00:49.66-0:00:51.46-hp07v": {
        "text": "部活を　始めました",
        "isStarred": true,
        "time": 1780387148076
      },
      "0:00:34.27-0:00:35.74-mg6clu": {
        "text": "小学生の時も",
        "isStarred": false,
        "time": 1780386923637
      },
      "0:02:23.74-0:02:24.92-9r20uk": {
        "text": "こんにちは",
        "isStarred": false,
        "time": 1780391765344
      },
      "0:02:25.64-0:02:28.25-jz0j45": {
        "text": "この三人が　軽音部の　仲間です",
        "isStarred": false,
        "time": 1780391821971
      },
      "0:02:28.41-0:02:29.19-q18d4z": {
        "text": "こんにちは",
        "isStarred": false,
        "time": 1780391915740
      },
      "0:02:29.33-0:02:31.61-foq7z3": {
        "text": "ベース担当の 秋山澪　ちゃん",
        "isStarred": false,
        "time": 1780392180661
      },
      "0:02:34.95-0:02:38.84-bdlitf": {
        "text": "背が高くてかっこいい　大人の女性 って感じです",
        "isStarred": true,
        "time": 1780542927621
      },
      "0:02:39.39-0:02:40.78-7zao9l": {
        "text": "ねえねえ　なんで　澪ちゃんは",
        "isStarred": false,
        "time": 1780393679316
      },
      "0:02:40.91-0:02:43.50-q5u0wi": {
        "text": "ギターじゃなくて　ベース　を　やろ　しようと思った",
        "isStarred": true,
        "time": 1780393968350
      },
      "0:02:45.58-0:02:46.76-8j5a70": {
        "text": "だって　ギターは",
        "isStarred": false,
        "time": 1780394412702
      },
      "0:02:47.52-0:02:48.71-cs7wzp": {
        "text": "は　恥ずかしい",
        "isStarred": false,
        "time": 1780394424054
      },
      "0:02:49.34-0:02:50.17-62ii86": {
        "text": "恥ずかしい",
        "isStarred": false,
        "time": 1780394451842
      },
      "0:02:50.36-0:02:52.81-gssj4f": {
        "text": "ギターって　バンドの中心　って感じで",
        "isStarred": true,
        "time": 1780412147295
      },
      "0:02:53.10-0:02:55.63-tioc4g": {
        "text": "先頭に　立って　演奏しなきゃいけないし",
        "isStarred": true,
        "time": 1780412140946
      },
      "0:02:56.00-0:02:58.35-95phf6": {
        "text": "観客の目も　自然と　あつまぅだろ",
        "isStarred": true,
        "time": 1780412149015
      },
      "0:02:59.29-0:03:02.54-j2l5d6": {
        "text": "自分が　その立場になるって　考えた　だけで",
        "isStarred": false,
        "time": 1780412503453
      },
      "0:03:04.33-0:03:05.26-bzfe66": {
        "text": "澪ちゃん",
        "isStarred": false,
        "time": 1780412514298
      },
      "0:03:05.39-0:03:07.69-ie52rf": {
        "text": "澪ちゃんは　少し　繊細です",
        "isStarred": false,
        "time": 1780412565303
      },
      "0:03:07.80-0:03:08.59-5kyfuy": {
        "text": "大丈夫",
        "isStarred": false,
        "time": 1780412634632
      },
      "0:03:09.17-0:03:11.89-ku1gxy": {
        "text": "キーボード担当　紬ちゃん",
        "isStarred": false,
        "time": 1780548912606
      },
      "0:03:17.00-0:03:18.08-7ca1ce": {
        "text": "通称　ムギちゃん",
        "isStarred": false,
        "time": 1780412721060
      },
      "0:03:18.51-0:03:21.20-kuxxgl": {
        "text": "おっとり　ぽわぽわ　可愛い人です",
        "isStarred": false,
        "time": 1780412826136
      },
      "0:03:21.87-0:03:23.93-xmtaws": {
        "text": "ムギちゃんは　キーボード　うまいよね",
        "isStarred": false,
        "time": 1780412847465
      },
      "0:03:24.21-0:03:25.81-dum3z7": {
        "text": "キーボード歴長いの",
        "isStarred": false,
        "time": 1780413006672
      },
      "0:03:26.13-0:03:28.89-tnhtvx": {
        "text": "私　四歳のころから　ピアノを　習ってたの",
        "isStarred": false,
        "time": 1780413227353
      },
      "0:03:29.24-0:03:31.96-doragc": {
        "text": "コンクールで賞を　もらった　こともあるのよ",
        "isStarred": false,
        "time": 1780413570804
      },
      "0:03:32.09-0:03:34.36-ichy82": {
        "text": "へえ　すごいね",
        "isStarred": false,
        "time": 1780413671711
      },
      "0:03:34.69-0:03:36.72-uoxg3i": {
        "text": "何で軽音部に　いるんだろう",
        "isStarred": false,
        "time": 1780413724523
      },
      "0:03:37.16-0:03:38.69-ciufyo": {
        "text": "さあ　いただきましょう",
        "isStarred": false,
        "time": 1780413927588
      },
      "0:03:40.01-0:03:42.71-xie5aw": {
        "text": "そういえば　ずっと　疑問に　思ってただけど",
        "isStarred": true,
        "time": 1780466329825
      },
      "0:03:43.01-0:03:45.49-3rqqkc": {
        "text": "この部室って　やけに　ものが　揃ってる　よね",
        "isStarred": true,
        "time": 1780466801373
      },
      "0:03:45.76-0:03:48.57-a2wia7": {
        "text": "最近の　高校って　こんな感じ　なのかな",
        "isStarred": false,
        "time": 1780466781282
      },
      "0:00:17.41-0:00:19.11-y6zqzt": {
        "text": "嬉しいよう　悲しい異様な",
        "isStarred": false,
        "time": 1780542763563
      },
      "0:00:21.81-0:00:24.77-vx2kp5": {
        "text": "今日は　ムギちゃん　おいしいお菓子持ってきてくれるんだ",
        "isStarred": false,
        "time": 1780542808214
      },
      "0:03:49.06-0:03:51.79-7sf5x": {
        "text": "ああ　それは　私の　ウチ　から　持ってきたのよ",
        "isStarred": true,
        "time": 1780545691076
      },
      "0:03:52.23-0:03:52.92-kemdzd": {
        "text": "自前",
        "isStarred": false,
        "time": 1780545723862
      },
      "0:03:53.24-0:03:53.83-xy1fhg": {
        "text": "はい",
        "isStarred": false,
        "time": 1780545728386
      },
      "0:03:54.02-0:03:56.92-sd258m": {
        "text": "ムギちゃんは　かなり　お嬢様　っぽいです",
        "isStarred": true,
        "time": 1780545947189
      },
      "0:03:57.59-0:04:00.06-di16l3": {
        "text": "ドラム担当の　田井中　律　ちゃん",
        "isStarred": false,
        "time": 1780546158130
      },
      "0:04:04.90-0:04:07.64-ha7rn0": {
        "text": "元気いっぽいの　明るい　女の子です",
        "isStarred": false,
        "time": 1780546323993
      },
      "0:04:08.14-0:04:10.74-bmw8f5": {
        "text": "律ちゃんは　ドラム　って感じだよね",
        "isStarred": false,
        "time": 1780546430751
      },
      "0:04:10.97-0:04:11.40-b1r7fc": {
        "text": "んな",
        "isStarred": false,
        "time": 1780546511446
      },
      "0:04:12.62-0:04:14.83-w3f7ft": {
        "text": "私にも　ちゃんと　すごく　立派な",
        "isStarred": true,
        "time": 1780546868732
      },
      "0:04:15.02-0:04:17.68-uikfmm": {
        "text": "聞けば誰でも　感動する理由が　あるんだぞ",
        "isStarred": true,
        "time": 1780547184774
      },
      "0:04:18.02-0:04:20.05-qy5fph": {
        "text": "へえ　どんな　どんな",
        "isStarred": false,
        "time": 1780547283271
      },
      "0:04:20.21-0:04:23.13-w9oy3": {
        "text": "それは　えっと　あれだ",
        "isStarred": false,
        "time": 1780547315761
      },
      "0:04:23.92-0:04:24.94-t9aa4y": {
        "text": "かっこいい　から",
        "isStarred": false,
        "time": 1780547378076
      },
      "0:04:25.42-0:04:26.17-yk44pc": {
        "text": "そこ",
        "isStarred": false,
        "time": 1780547704976
      },
      "0:04:27.13-0:04:28.19-5bn0ml": {
        "text": "だってさ",
        "isStarred": false,
        "time": 1780547821710
      },
      "0:04:28.47-0:04:30.66-sye65m": {
        "text": "ギターとか　ベースとか　キーボードとか",
        "isStarred": false,
        "time": 1780547849696
      },
      "0:04:30.99-0:04:33.58-t46blu": {
        "text": "指で　ちまちま　ちまちまするの　を　想像しただけで",
        "isStarred": true,
        "time": 1780548091437
      },
      "0:04:33.79-0:04:36.46-7es20l": {
        "text": "きーー　ってなるんだよ",
        "isStarred": false,
        "time": 1780548113084
      },
      "0:04:37.63-0:04:40.65-mf61a6": {
        "text": "楽器　選び　にも　性格が　出るんだな",
        "isStarred": false,
        "time": 1780548432401
      },
      "0:04:46.55-0:04:47.66-m9mmx8": {
        "text": "おかわりは　いかが",
        "isStarred": false,
        "time": 1780564545874
      },
      "0:04:48.57-0:04:49.40-cl7kfv": {
        "text": "ありがどう",
        "isStarred": false,
        "time": 1780564560970
      },
      "0:04:50.55-0:04:53.85-re4jov": {
        "text": "そういえば　ムギちゃんは　合唱部に　入りたかった　んでょ",
        "isStarred": true,
        "time": 1780564770059
      },
      "0:04:54.42-0:04:56.96-288bqk": {
        "text": "ええ　でも　滅多に　出会えない",
        "isStarred": true,
        "time": 1780565002552
      },
      "0:04:57.17-0:05:00.81-70fxii": {
        "text": "とっても　楽しくて　愉快な　人たち　の　仲間に　なりたかったの",
        "isStarred": true,
        "time": 1780565179935
      },
      "0:05:01.46-0:05:03.51-u47rtp": {
        "text": "珍獣ってことですか",
        "isStarred": false,
        "time": 1780565623598
      },
      "0:05:04.51-0:05:07.68-5qixhr": {
        "text": "そういえば　平沢さん　もうギターは　買ったの",
        "isStarred": false,
        "time": 1780565735395
      },
      "0:05:08.45-0:05:09.43-1juoyb": {
        "text": "唯　でいいよ",
        "isStarred": false,
        "time": 1780565847256
      },
      "0:05:10.35-0:05:13.65-6xkdfp": {
        "text": "私　すでに澪ちゃん　のこと　澪ちゃん　って呼んでるし",
        "isStarred": true,
        "time": 1780566079842
      },
      "0:05:18.82-0:05:20.33-xdoqdq": {
        "text": "ゆい",
        "isStarred": false,
        "time": 1780566138424
      },
      "0:05:22.37-0:05:23.70-k15xq8": {
        "text": "可愛い",
        "isStarred": false,
        "time": 1780566143701
      },
      "0:05:23.87-0:05:25.22-1limts": {
        "text": "で　唯　ギターは",
        "isStarred": false,
        "time": 1780566222092
      },
      "0:05:26.19-0:05:26.92-c4ns9p": {
        "text": "ギター",
        "isStarred": false,
        "time": 1780566224374
      },
      "0:05:27.80-0:05:30.05-egbfxg": {
        "text": "あ　そっか　忘れてた",
        "isStarred": false,
        "time": 1780566240390
      },
      "0:05:30.40-0:05:32.19-o5x820": {
        "text": "私　ギター　やる　んだっけ",
        "isStarred": false,
        "time": 1780566330989
      },
      "0:05:32.39-0:05:34.19-5qgija": {
        "text": "軽音部は　喫茶店　じゃないぞ",
        "isStarred": false,
        "time": 1780566386024
      },
      "0:05:35.90-0:05:39.10-1lny98": {
        "text": "ギターって　どれぐらい　するの　値段",
        "isStarred": false,
        "time": 1780566566470
      },
      "0:05:40.10-0:05:43.88-vqmugb": {
        "text": "う〜ん　安いのは　一万年代　からある　けど",
        "isStarred": false,
        "time": 1780567042111
      },
      "0:05:44.15-0:05:46.56-y5odq": {
        "text": "あんまり　安すぎる　のも　よくない　から　な",
        "isStarred": true,
        "time": 1780567571198
      },
      "0:05:46.90-0:05:48.81-gpmv4v": {
        "text": "五万円　くらいが　いいかも",
        "isStarred": false,
        "time": 1780567625630
      },
      "0:05:50.18-0:05:54.30-9tu6gy": {
        "text": "五万　私の　お小遣い　10か月分",
        "isStarred": false,
        "time": 1780567925471
      },
      "0:05:54.55-0:05:57.27-lmithx": {
        "text": "高いのは　十万円　以上　する　の　もあのよ",
        "isStarred": false,
        "time": 1780568102313
      },
      "0:05:57.89-0:05:59.40-qqohlz": {
        "text": "部費で　落ちませんか",
        "isStarred": false,
        "time": 1780568145120
      },
      "0:05:59.59-0:06:00.41-w762uq": {
        "text": "落ちません",
        "isStarred": false,
        "time": 1780568208225
      },
      "0:06:03.80-0:06:05.20-h749dh": {
        "text": "これ　美味しいわよ",
        "isStarred": false,
        "time": 1780568220377
      },
      "0:06:13.73-0:06:17.11-8u3avw": {
        "text": "とにかく　楽器が　ないと　何も始まらない　しな",
        "isStarred": true,
        "time": 1780585464677
      },
      "0:06:17.29-0:06:20.72-r7disq": {
        "text": "よ〜し　今度の　休みに　ギター　目に行こ　うぜ",
        "isStarred": false,
        "time": 1780585652147
      },
      "0:06:32.25-0:06:33.44-tncc9a": {
        "text": "無念なり",
        "isStarred": false,
        "time": 1780585743894
      }
    }
  },
  "progress": {}
}